# Plantilla de configuración. Copiar como .env y completar. El archivo .env NO se sube a git.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_TOKENS_SALIDA=4000
LLM_PAUSA_SEGUNDOS=0
LLM_TIMEOUT_SEGUNDOS=90

# API (FastAPI)
STUDYFLOW_DB=studyflow.db
STUDYFLOW_TZ=America/Bogota
STUDYFLOW_CORS=http://localhost:5173
LIMITE_PETICIONES_MIN=10
LIMITE_ESTUDIANTES_IP_HORA=20
LIMITE_LLM_DIA=500
